#!/bin/bash
# SPDX-License-Identifier: 0BSD
#
# Remove what ./install added: the fold stack, and the panel fixes unless
# --keep-panel-fixes is given. Puts the distribution's iio-sensor-proxy back.

set -euo pipefail

SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
readonly SCRIPT_DIR

readonly BINARY=/usr/local/libexec/iio-sensor-proxy
readonly SYSTEM_UNIT=/etc/systemd/system/iio-sensor-proxy.service
readonly DROPIN_DIR=/etc/systemd/system/iio-sensor-proxy.service.d
readonly UDEV_RULE=/etc/udev/rules.d/70-minibook-rotation-fix.rules
readonly SELINUX_MODULE=minibook_iio_sensor_proxy
readonly USER_DAEMON=minibook-rotation-fix.py
readonly USER_UNIT=minibook-rotation-fix.service
readonly USER_DATA_DIR=.local/share/minibook

WITH_PANEL_FIXES=1

log() { echo "==> $*"; }
warn() { echo "Warning: $*" >&2; }
die() {
  echo "Error: $*" >&2
  exit 1
}

target_user() {
  echo "${SUDO_USER:-$(id -un)}"
}

target_home() {
  local user
  local home

  user="$(target_user)"
  home="$(getent passwd "${user}" | cut -d: -f6)"
  if [[ -z "${home}" ]]; then
    warn "cannot determine the home directory of ${user}, skipping user files"
  fi
  echo "${home}"
}

elevate() {
  if [[ ${EUID} -eq 0 ]]; then
    return
  fi
  log "elevating with sudo"
  exec sudo -- "$0" "$@"
}

stop_user_service() {
  local user
  local uid
  local runtime
  local home

  user="$(target_user)"
  home="$(target_home)"
  uid="$(id -u "${user}")"
  runtime="/run/user/${uid}"
  if [[ -z "${home}" || ! -d "${runtime}" ]]; then
    return
  fi
  log "stopping the rotation daemon"
  sudo -u "${user}" XDG_RUNTIME_DIR="${runtime}" systemctl --user disable --now \
    "${USER_UNIT}" \
    || warn "could not stop ${USER_UNIT}"
}

remove_system_files() {
  log "removing system files"
  rm -f "${SYSTEM_UNIT}"
  rm -f "${DROPIN_DIR}/panel.conf"
  rmdir "${DROPIN_DIR}" 2>/dev/null || true
  rm -f "${UDEV_RULE}"
  rm -f "${BINARY}"
  rmdir /usr/local/libexec 2>/dev/null || true
}

remove_selinux_module() {
  if ! command -v semodule >/dev/null; then
    return
  fi
  log "removing the SELinux policy module"
  semodule -r "${SELINUX_MODULE}" 2>/dev/null || true
  semanage fcontext -d "${BINARY}" 2>/dev/null || true
}

remove_user_files() {
  local home

  home="$(target_home)"
  if [[ -z "${home}" ]]; then
    return
  fi
  log "removing user files"
  rm -f "${home}/.local/bin/${USER_DAEMON}"
  rm -f "${home}/.config/systemd/user/${USER_UNIT}"
  rm -rf "${home}/${USER_DATA_DIR}"
}

restore_package() {
  local pid
  local exe

  log "restoring the distribution's iio-sensor-proxy"
  dnf reinstall -y iio-sensor-proxy \
    || warn "cannot reinstall iio-sensor-proxy, run it yourself if the fork"
  systemctl daemon-reload
  udevadm control --reload-rules
  systemctl restart iio-sensor-proxy || warn "cannot restart iio-sensor-proxy"
  sleep 2
  pid="$(systemctl show -p MainPID --value iio-sensor-proxy)"
  exe="$(readlink "/proc/${pid}/exe" 2>/dev/null || true)"
  log "iio-sensor-proxy running from ${exe}"
  if [[ "${exe}" == "${BINARY}" ]]; then
    warn "the service is still running the fork"
  fi
}

usage() {
  cat <<EOF
Usage: ./uninstall [--keep-panel-fixes]

  --keep-panel-fixes  leave the VBT patch, kernel arguments and boot settings
                      alone, and only remove the fold / tablet-mode half
EOF
  exit 0
}

parse_args() {
  while [[ $# -gt 0 ]]; do
    case "$1" in
    --keep-panel-fixes)
      WITH_PANEL_FIXES=0
      shift
      ;;
    -h | --help)
      usage
      ;;
    *)
      die "unknown option: $1"
      ;;
    esac
  done
}

revert_panel_fixes() {
  if [[ "${WITH_PANEL_FIXES}" -eq 0 ]]; then
    log "keeping the panel fixes (--keep-panel-fixes)"
    return
  fi
  "${SCRIPT_DIR}/tools/panel_fixes.sh" --revert \
    || warn "could not revert the panel fixes, run tools/panel_fixes.sh --revert"
}

main() {
  parse_args "$@"
  elevate "$@"
  stop_user_service
  remove_system_files
  remove_selinux_module
  remove_user_files
  revert_panel_fixes
  restore_package
  log "done, keyboard and touchpad are no longer affected by folding"
}

main "$@"
